# ============================================================================
# Environment variables — NAMES and SAFE PLACEHOLDERS ONLY.
# Never put real secrets in this file; it is committed to git.
# Real values go in .env.local (gitignored) for local dev, and in the
# Cloudflare Pages/Workers dashboard → Settings → Environment variables for
# production/preview (mark secrets as "Encrypted").
# ============================================================================

# ── Server-only secret (required) ──────────────────────────────────────────
# PostgreSQL connection string (Neon). Never exposed to the browser. Also
# read at Next.js BUILD time (module import, not a query) by lib/auth.ts, so
# it must be present wherever `next build` / `opennextjs-cloudflare build`
# runs — but no live DB connection is attempted during the build itself.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional: cap the pg.Pool size. Defaults to 25 if unset.
DATABASE_POOL_MAX=25

# ── Server-only secret (required) ──────────────────────────────────────────
# Better Auth session-signing secret. Generate with: openssl rand -hex 32
# Read at module-import time (fails the build fast if missing) — required as
# a Cloudflare build-time variable, not just a runtime one.
BETTER_AUTH_SECRET=replace-with-a-64-char-hex-secret

# Server-only. Base URL Better Auth uses to build its own links. Should match
# the deployed frontend origin in production.
#   Local/dev:  http://localhost:3000
#   Production: https://your-frontend.pages.dev (or your custom domain)
BETTER_AUTH_URL=http://localhost:3000

# ── Browser/public variable ─────────────────────────────────────────────────
# The deployed frontend's own public URL. Used to build absolute links in
# emails/notifications (password reset, welcome email, etc.) so they never
# resolve to localhost in production. Safe to expose — it's just this site's
# own URL.
NEXT_PUBLIC_APP_URL=https://your-frontend.pages.dev

# ── Server-only, "Backend URL" (required in production) ────────────────────
# Base URL of the Railway Express backend (email/Teams notification bridge).
# Server-side only — never bundled into browser JS, so NEXT_PUBLIC_ is not
# required for it to work server-side. Must be the backend's PUBLIC HTTPS
# Railway URL in production — never localhost, 127.0.0.1, or a Railway
# *.internal hostname (those are unreachable from outside Railway's private
# network / from the browser).
#   Local/dev:  BACKEND_URL=http://localhost:4000 (also the built-in fallback
#               when left unset in development)
#   Production: BACKEND_URL=https://your-backend.up.railway.app
BACKEND_URL=http://localhost:4000

# ── Browser/public variable (optional fallback) ─────────────────────────────
# Same value as BACKEND_URL, exposed to the browser as a fallback for any
# client-side code path that needs the backend origin directly. Leave unset
# unless a specific client-side feature requires it — prefer BACKEND_URL
# (server-only) wherever the call happens on the server.
NEXT_PUBLIC_BACKEND_URL=

# ── Server-only secrets (optional — required only if file/image uploads are
#    used) ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Server-only (optional) ──────────────────────────────────────────────────
# Support email — receives password-reset requests from the portal.
SUPPORT_EMAIL=support@supporthub.com

# Company display name used in outgoing notification emails.
COMPANY_NAME=Support Hero

# Email delivery is handled entirely by the backend email service
# (see Backend/.env.example — EMAIL_PROVIDER, EMAIL_FROM, MICROSOFT_*).
# Never put email provider credentials (SMTP/Resend/Microsoft) in frontend
# variables.

# ── Browser/public variable (optional — not yet wired to a Sentry SDK) ─────
NEXT_PUBLIC_SENTRY_DSN=

# ── Cloudflare Pages/Workers build-time variable (optional, dev-only) ──────
# Enables verbose perf logging (auth-utils cache timing, SQL timing). Leave
# unset in production.
DEBUG_PERF=
PERF_AUDIT=

# ── Environment ──────────────────────────────────────────────────────────
NODE_ENV=development

# ── Vercel (not used for Cloudflare deployment — safe to leave unset) ──────
# VERCEL_URL=
# VERCEL_PROJECT_PRODUCTION_URL=
# V0_RUNTIME_URL=
