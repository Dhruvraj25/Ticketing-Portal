# Database
DATABASE_URL=postgresql://neondb_owner:npg_06TeuIUgVLXM@ep-sweet-river-aqhwknkv-pooler.c-8.us-east-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-key-change-this-in-production

# Cloudinary (optional - for file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Environment
NODE_ENV=development

# Support email — receives password-reset requests from the portal
SUPPORT_EMAIL=support@supporthub.com

# Email delivery is handled entirely by the backend email service
# (see Backend/.env.example — EMAIL_PROVIDER, EMAIL_FROM, MICROSOFT_*).
# Never put email provider credentials (SMTP/Resend/Microsoft) in frontend variables.

# Vercel (optional - only needed for Vercel deployment)
# VERCEL_URL=
# VERCEL_PROJECT_PRODUCTION_URL=
# V0_RUNTIME_URL=
